OpStore %21 %32
%33 = OpCompositeExtract  %6  %31 1
OpStore %23 %33
%37 = OpAccessChain  %34  %23 %35
%38 = OpLoad  %4  %37
%39 = OpFNegate  %4  %38
OpStore %37 %39
OpReturn
OpFunctionEnd
%45 = OpFunction  %2  None %25
