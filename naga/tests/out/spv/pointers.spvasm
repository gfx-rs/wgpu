; SPIR-V
; Version: 1.2
; Generator: rspirv
; Bound: 32
OpCapability Shader
OpCapability Linkage
OpExtension "SPV_KHR_storage_buffer_storage_class"
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
%3 = OpString "pointers.wgsl"
OpSource Unknown 0 %3 "struct DynamicArray {
    arr: array<u32>
}

@group(0) @binding(0)
var<storage, read_write> dynamic_array: DynamicArray;

fn index_unsized(i: i32, v: u32) {
   let p: ptr<storage, DynamicArray, read_write> = &dynamic_array;

   let val = (*p).arr[i];
   (*p).arr[i] = val + v;
}

fn index_dynamic_array(i: i32, v: u32) {
   let p: ptr<storage, array<u32>, read_write> = &dynamic_array.arr;

   let val = (*p)[i];
   (*p)[i] = val + v;
}
"
OpMemberName %6 0 "arr"
OpName %6 "DynamicArray"
OpName %8 "dynamic_array"
OpName %11 "i"
OpName %12 "v"
OpName %13 "index_unsized"
OpName %24 "i"
OpName %25 "v"
OpName %26 "index_dynamic_array"
OpDecorate %5 ArrayStride 4
OpMemberDecorate %6 0 Offset 0
OpDecorate %6 Block
OpDecorate %8 DescriptorSet 0
OpDecorate %8 Binding 0
%2 = OpTypeVoid
%4 = OpTypeInt 32 0
%5 = OpTypeRuntimeArray %4
%6 = OpTypeStruct %5
%7 = OpTypeInt 32 1
%9 = OpTypePointer StorageBuffer %6
%8 = OpVariable  %9  StorageBuffer
%14 = OpTypeFunction %2 %7 %4
%16 = OpTypePointer StorageBuffer %5
%17 = OpTypePointer StorageBuffer %4
%18 = OpConstant  %4  0
%13 = OpFunction  %2  None %14
%11 = OpFunctionParameter  %7
%12 = OpFunctionParameter  %4
%10 = OpLabel
OpBranch %15
%15 = OpLabel
OpLine %3 11 14
%19 = OpAccessChain  %17  %8 %18 %11
%20 = OpLoad  %4  %19
OpLine %3 12 4
%21 = OpIAdd  %4  %20 %12
OpLine %3 12 4
%22 = OpAccessChain  %17  %8 %18 %11
OpStore %22 %21
OpReturn
OpFunctionEnd
%26 = OpFunction  %2  None %14
%24 = OpFunctionParameter  %7
%25 = OpFunctionParameter  %4
%23 = OpLabel
OpBranch %27
%27 = OpLabel
OpLine %3 16 51
OpLine %3 18 14
%28 = OpAccessChain  %17  %8 %18 %24
%29 = OpLoad  %4  %28
OpLine %3 19 4
%30 = OpIAdd  %4  %29 %25
OpLine %3 19 4
%31 = OpAccessChain  %17  %8 %18 %24
OpStore %31 %30
OpReturn
OpFunctionEnd