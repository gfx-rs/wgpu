; SPIR-V
; Version: 1.0
; Generator: rspirv
; Bound: 39
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %22 "compute" %10 %13 %15 %18 %20
OpExecutionMode %22 LocalSize 1 1 1
OpDecorate %4 ArrayStride 4
OpDecorate %10 BuiltIn GlobalInvocationId
OpDecorate %13 BuiltIn LocalInvocationId
OpDecorate %15 BuiltIn LocalInvocationIndex
OpDecorate %18 BuiltIn WorkgroupId
OpDecorate %20 BuiltIn NumWorkgroups
%2 = OpTypeVoid
%3 = OpTypeInt 32 0
