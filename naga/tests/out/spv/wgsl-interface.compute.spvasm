; SPIR-V
; Version: 1.0
; Generator: rspirv
; Bound: 44
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %22 "compute" %10 %13 %15 %18 %20
OpExecutionMode %22 LocalSize 1 1 1
OpDecorate %4 ArrayStride 4
OpDecorate %10 BuiltIn GlobalInvocationId
OpDecorate %13 BuiltIn LocalInvocationId
OpDecorate %15 BuiltIn LocalInvocationIndex
OpDecorate %18 BuiltIn WorkgroupId
OpDecorate %20 BuiltIn NumWorkgroups
%2 = OpTypeVoid
%3 = OpTypeInt 32 0
%5 = OpConstant  %3  1
%4 = OpTypeArray %3 %5
%6 = OpTypeVector %3 3
%8 = OpTypePointer Workgroup %4
%7 = OpVariable  %8  Workgroup
%11 = OpTypePointer Input %6
%10 = OpVariable  %11  Input
%13 = OpVariable  %11  Input
%16 = OpTypePointer Input %3
%15 = OpVariable  %16  Input
%18 = OpVariable  %11  Input
%20 = OpVariable  %11  Input
%23 = OpTypeFunction %2
%25 = OpConstantNull  %4
%26 = OpConstant  %3  0
%28 = OpTypeBool
%31 = OpConstant  %3  2
%32 = OpConstant  %3  264
%34 = OpTypePointer Workgroup %3
%22 = OpFunction  %2  None %23
%9 = OpLabel
%12 = OpLoad  %6  %10
%14 = OpLoad  %6  %13
%17 = OpLoad  %3  %15
%19 = OpLoad  %6  %18
%21 = OpLoad  %6  %20
OpBranch %24
%24 = OpLabel
%27 = OpIEqual  %28  %17 %26
OpSelectionMerge %29 None
OpBranchConditional %27 %30 %29
%30 = OpLabel
OpStore %7 %25
OpBranch %29
%29 = OpLabel
OpControlBarrier %31 %31 %32
OpBranch %33
%33 = OpLabel
%35 = OpCompositeExtract  %3  %12 0
%36 = OpCompositeExtract  %3  %14 0
%37 = OpIAdd  %3  %35 %36
%38 = OpIAdd  %3  %37 %17
%39 = OpCompositeExtract  %3  %19 0
%40 = OpIAdd  %3  %38 %39
%41 = OpCompositeExtract  %3  %21 0
%42 = OpIAdd  %3  %40 %41
%43 = OpAccessChain  %34  %7 %26
OpStore %43 %42
OpReturn
OpFunctionEnd