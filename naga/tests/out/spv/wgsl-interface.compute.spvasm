%4 = OpTypeArray %3 %5
%6 = OpTypeVector %3 3
%8 = OpTypePointer Workgroup %4
%7 = OpVariable  %8  Workgroup
%11 = OpTypePointer Input %6
%10 = OpVariable  %11  Input
%13 = OpVariable  %11  Input
%16 = OpTypePointer Input %3
%15 = OpVariable  %16  Input
%18 = OpVariable  %11  Input
%20 = OpVariable  %11  Input
%23 = OpTypeFunction %2
%24 = OpConstant  %3  0
%26 = OpTypePointer Workgroup %3
%28 = OpConstant  %3  2
%29 = OpConstant  %3  264
%22 = OpFunction  %2  None %23
%9 = OpLabel
%12 = OpLoad  %6  %10
%14 = OpLoad  %6  %13
%17 = OpLoad  %3  %15
%19 = OpLoad  %6  %18
%21 = OpLoad  %6  %20
OpBranch %25
%25 = OpLabel
%27 = OpAccessChain  %26  %7 %17
OpStore %27 %24
OpControlBarrier %28 %28 %29
%30 = OpCompositeExtract  %3  %12 0
%31 = OpCompositeExtract  %3  %14 0
%32 = OpIAdd  %3  %30 %31
%33 = OpIAdd  %3  %32 %17
%34 = OpCompositeExtract  %3  %19 0
%35 = OpIAdd  %3  %33 %34
%36 = OpCompositeExtract  %3  %21 0
%37 = OpIAdd  %3  %35 %36
%38 = OpAccessChain  %26  %7 %24
OpStore %38 %37
OpReturn
OpFunctionEnd