; SPIR-V
; Version: 1.0
; Generator: rspirv
; Bound: 31
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %21 "vertex" %8 %11 %13 %15 %17 %19
OpMemberDecorate %5 0 Offset 0
OpMemberDecorate %5 1 Offset 16
OpDecorate %8 BuiltIn VertexIndex
OpDecorate %11 BuiltIn InstanceIndex
OpDecorate %13 Location 10
OpDecorate %15 BuiltIn Position
OpDecorate %15 Invariant
OpDecorate %17 Location 1
OpDecorate %19 BuiltIn PointSize
%2 = OpTypeVoid
%3 = OpTypeFloat 32
%4 = OpTypeVector %3 4
%5 = OpTypeStruct %4 %3
%6 = OpTypeInt 32 0
%9 = OpTypePointer Input %6
%8 = OpVariable  %9  Input
%11 = OpVariable  %9  Input
%13 = OpVariable  %9  Input
%16 = OpTypePointer Output %4
%15 = OpVariable  %16  Output
%18 = OpTypePointer Output %3
%17 = OpVariable  %18  Output
%19 = OpVariable  %18  Output
%20 = OpConstant  %3  1
%22 = OpTypeFunction %2
%23 = OpConstantComposite  %4  %20 %20 %20 %20
%21 = OpFunction  %2  None %22
%7 = OpLabel
%10 = OpLoad  %6  %8
%12 = OpLoad  %6  %11
%14 = OpLoad  %6  %13
OpStore %19 %20
OpBranch %24
%24 = OpLabel
%25 = OpIAdd  %6  %10 %12
%26 = OpIAdd  %6  %25 %14
%27 = OpConvertUToF  %3  %26
%28 = OpCompositeConstruct  %5  %23 %27
%29 = OpCompositeExtract  %4  %28 0
OpStore %15 %29
%30 = OpCompositeExtract  %3  %28 1
OpStore %17 %30
OpReturn
OpFunctionEnd