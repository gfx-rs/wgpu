; SPIR-V
; Version: 1.0
; Generator: rspirv
; Bound: 18
OpCapability Shader
%1 = OpExtInstImport "GLSL.std.450"
OpMemoryModel Logical GLSL450
OpEntryPoint Fragment %8 "struct_greater" %6
OpExecutionMode %8 OriginUpperLeft
OpExecutionMode %8 DepthReplacing
OpExecutionMode %8 DepthGreater
OpMemberDecorate %4 0 Offset 0
OpDecorate %6 BuiltIn FragDepth
%2 = OpTypeVoid
