%7 = OpLabel
%11 = OpVariable  %12  Function %13
OpBranch %14
%14 = OpLabel
%15 = OpLoad  %3  %5
OpStore %11 %15
%16 = OpLoad  %3  %11
OpStore %11 %10
OpStore %5 %16
OpReturn
OpFunctionEnd
%18 = OpFunction  %2  None %9
%17 = OpLabel
OpBranch %19
%19 = OpLabel
