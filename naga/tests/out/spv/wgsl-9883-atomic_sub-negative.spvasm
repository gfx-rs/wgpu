%16 = OpConstant  %13  0
%18 = OpTypeBool
%21 = OpConstant  %13  2
%22 = OpConstant  %13  264
%25 = OpConstant  %3  2
%7 = OpFunction  %2  None %8
%6 = OpLabel
OpBranch %10
%10 = OpLabel
%15 = OpLoad  %13  %12
%17 = OpIEqual  %18  %15 %16
OpSelectionMerge %19 None
